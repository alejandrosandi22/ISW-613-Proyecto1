# Variables de Docker Compose. Copie este archivo como .env y cambie las claves.
# .env está excluido de Git.

# Clave del usuario root de MariaDB (solo administración y phpMyAdmin).
DB_ROOT_PASSWORD=cambiar_clave_root

# Usuario que usa la aplicación (SELECT, INSERT, UPDATE, DELETE sobre sigel).
# Deben coincidir con 'user' y 'password' de config/config.php.
DB_APP_USER=sigel_app
DB_APP_PASSWORD=cambiar_esta_clave

# Puertos en el equipo local (distintos a 3306/8080 para no chocar con otras bases).
DB_PORT=3307
PMA_PORT=8081
